#include "pole_import_dialog.h"

PoleImportDialog::PoleImportDialog() { initializeComponent(); }

void PoleImportDialog::initializeComponent()
{
    setTitle("Importera stolptabell");
    setContentSize(1100, 760);
    setMinimumContentSize(860, 600);
    setStartPosition(glaze::StartPosition::CenterOwner);
    setModal(true);
    setAcceptButton(okBtn);
    setCancelButton(cancelBtn);

    hintLbl.name = "hintLbl";
    hintLbl.setText("Stolparna hämtas ur en stolptabell från Banken (.xlsx eller .xlsm). Kalkyl läser filen som den senast sparades och kör aldrig makron. Varje fält i Stolptabell före hämtas ur kolumnen som står vald nedan. Kontrollera dem, särskilt de som inte är säkra.");
    hintLbl.setRole(glaze::Label::Role::Dim);
    hintLbl.setWrap(true);
    hintLbl.anchors = {true, true, true, false};
    hintLbl.x = 16;
    hintLbl.y = 12;
    hintLbl.right = 16;

    fileLbl.name = "fileLbl";
    fileLbl.setText("Fil");
    fileLbl.setBuddy("fileBox");
    fileLbl.x = 16;
    fileLbl.anchorTop = {"hintLbl", 8};

    fileBox.name = "fileBox";
    fileBox.setMode(glaze::FileDialogMode::Open);
    fileBox.addFilter("Excel-filer", "*.xlsx;*.xlsm");
    fileBox.addFilter(glaze::tr(43), "*.*");
    fileBox.setDialogTitle("Importera stolptabell");
    fileBox.anchors = {true, true, true, false};
    fileBox.x = 80;
    fileBox.anchorTop = {"hintLbl", 8};
    fileBox.right = 16;

    infoLbl.name = "infoLbl";
    infoLbl.setWrap(true);
    infoLbl.anchors = {true, true, true, false};
    infoLbl.x = 80;
    infoLbl.anchorTop = {"fileBox", 8};
    infoLbl.right = 16;

    fieldsRubrik.name = "fieldsRubrik";
    fieldsRubrik.setText("Kolumner");
    fieldsRubrik.setRole(glaze::Label::Role::Heading);
    fieldsRubrik.x = 16;
    fieldsRubrik.anchorTop = {"infoLbl", 12};

    fieldGrid.name = "fieldGrid";
    fieldGrid.anchors = {true, true, true, false};
    fieldGrid.x = 16;
    fieldGrid.anchorTop = {"fieldsRubrik", 8};
    fieldGrid.right = 16;
    fieldGrid.height = 250;
    fieldGrid.setSortable(false);
    fieldGrid.setColumns({{.text = "Fält", .width = 170}, {.text = "Kolumn i filen", .width = 460}, {.text = "Säkerhet", .width = 110}, {.text = "Första värdet", .sizing = glaze::ColumnSizing::Autosize}});
    fieldGrid.setColumnEditor(0, {glaze::DataGrid::Editor::None});
    fieldGrid.setColumnEditor(1, {glaze::DataGrid::Editor::Choice});
    fieldGrid.setColumnEditor(2, {glaze::DataGrid::Editor::None});
    fieldGrid.setColumnEditor(3, {glaze::DataGrid::Editor::None});
    fieldGrid.setColumnToolTip(1, "Kolumnen i Excelfilen som fältet hämtas ur. Klicka för att välja en annan.");
    fieldGrid.setColumnToolTip(2, "Hur säkert rubriken känns igen. Peka på cellen för skälet.");
    fieldGrid.setColumnToolTip(3, "Värdet på första raden som importeras, som det står i filen");

    rangeRubrik.name = "rangeRubrik";
    rangeRubrik.setText("Stolpar");
    rangeRubrik.setRole(glaze::Label::Role::Heading);
    rangeRubrik.x = 16;
    rangeRubrik.anchorTop = {"fieldGrid", 12};

    fromLbl.name = "fromLbl";
    fromLbl.setText("Från");
    fromLbl.setBuddy("fromDrop");
    fromLbl.x = 16;
    fromLbl.anchorTop = {"rangeRubrik", 8};

    fromDrop.name = "fromDrop";
    fromDrop.setToolTip("Första stolpen som importeras");
    fromDrop.width = 220;
    fromDrop.anchorLeft = {"fromLbl", 8};
    fromDrop.anchorTop = {"rangeRubrik", 8};

    toLbl.name = "toLbl";
    toLbl.setText("till");
    toLbl.setBuddy("toDrop");
    toLbl.anchorLeft = {"fromDrop", 16};
    toLbl.anchorTop = {"rangeRubrik", 8};

    toDrop.name = "toDrop";
    toDrop.setToolTip("Sista stolpen som importeras");
    toDrop.width = 220;
    toDrop.anchorLeft = {"toLbl", 8};
    toDrop.anchorTop = {"rangeRubrik", 8};

    allBtn.name = "allBtn";
    allBtn.setText("Alla stolpar");
    allBtn.setToolTip("Från första till sista stolpen i filen");
    allBtn.anchorLeft = {"toDrop", 16};
    allBtn.anchorTop = {"rangeRubrik", 8};

    countLbl.name = "countLbl";
    countLbl.setBuddy("fromDrop");
    countLbl.anchorLeft = {"allBtn", 16};
    countLbl.anchorTop = {"rangeRubrik", 8};

    previewRubrik.name = "previewRubrik";
    previewRubrik.setText("Förhandsvisning");
    previewRubrik.setRole(glaze::Label::Role::Heading);
    previewRubrik.x = 16;
    previewRubrik.anchorTop = {"fromDrop", 12};

    previewGrid.name = "previewGrid";
    previewGrid.anchors = {true, true, true, true};
    previewGrid.x = 16;
    previewGrid.anchorTop = {"previewRubrik", 8};
    previewGrid.right = 16;
    previewGrid.anchorBottom = {"issuesLbl", 8};
    previewGrid.setSortable(false);
    previewGrid.setHeaderLines(2);
    previewGrid.setColumns({{.text = "Rad", .width = 60, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Raden i Excelfilen"}, {.text = "Stolpnr", .width = 120, .sizing = glaze::ColumnSizing::Autosize}, {.text = "Koordinat\nN", .width = 120, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin}, {.text = "Koordinat\nE", .width = 110, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin}, {.text = "Koordinat\nH", .width = 80, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin}, {.text = "Avstånd\nföregående", .width = 90, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin}, {.text = "Ah", .width = 70, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin}, {.text = "Av", .width = 70, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin}, {.text = "LKL", .width = 80, .sizing = glaze::ColumnSizing::AutoMin}});
    previewGrid.setColumnEditor(0, {glaze::DataGrid::Editor::None});
    previewGrid.setColumnEditor(1, {glaze::DataGrid::Editor::None});
    previewGrid.setColumnEditor(2, {glaze::DataGrid::Editor::None});
    previewGrid.setColumnEditor(3, {glaze::DataGrid::Editor::None});
    previewGrid.setColumnEditor(4, {glaze::DataGrid::Editor::None});
    previewGrid.setColumnEditor(5, {glaze::DataGrid::Editor::None});
    previewGrid.setColumnEditor(6, {glaze::DataGrid::Editor::None});
    previewGrid.setColumnEditor(7, {glaze::DataGrid::Editor::None});
    previewGrid.setColumnEditor(8, {glaze::DataGrid::Editor::None});

    issuesLbl.name = "issuesLbl";
    issuesLbl.setWrap(true);
    issuesLbl.anchors = {true, false, true, true};
    issuesLbl.x = 16;
    issuesLbl.right = 16;
    issuesLbl.anchorBottom = {"cancelBtn", 12};

    cancelBtn.name = "cancelBtn";
    cancelBtn.setText("Avbryt");
    cancelBtn.setDialogResult(glaze::DialogResult::Cancel);
    cancelBtn.width = 96;
    cancelBtn.anchors = {false, false, true, true};
    cancelBtn.right = 16;
    cancelBtn.bottom = 16;

    okBtn.name = "okBtn";
    okBtn.setText("Importera");
    okBtn.setToolTip("Ersätter raderna i Stolptabell före med stolparna i förhandsvisningen");
    okBtn.width = 110;
    okBtn.anchors = {false, false, true, true};
    okBtn.anchorRight = {"cancelBtn", 8};
    okBtn.bottom = 16;

    fileBox.onCommit = [this](glaze::Widget* s, glaze::ChangeArgs& e) { fileBoxCommitted(s, e); };
    fieldGrid.onCommit = [this](glaze::Widget* s, glaze::CellChangeArgs& e) { fieldGridCommitted(s, e); };
    fromDrop.onChange = [this](glaze::Widget* s, glaze::ChangeArgs& e) { rangeChanged(s, e); };
    toDrop.onChange = [this](glaze::Widget* s, glaze::ChangeArgs& e) { rangeChanged(s, e); };
    allBtn.onClick = [this](glaze::Widget* s, glaze::ClickArgs& e) { allBtnClicked(s, e); };
    okBtn.onClick = [this](glaze::Widget* s, glaze::ClickArgs& e) { okBtnClicked(s, e); };
    glaze::AppWindow::onLoad = [this](glaze::Widget* s, glaze::EventArgs& e) { onLoad(s, e); };

    root().adopt(hintLbl);
    root().adopt(cancelBtn);
    root().adopt(okBtn);
    root().adopt(issuesLbl);
    root().adopt(fileLbl);
    root().adopt(fileBox);
    root().adopt(infoLbl);
    root().adopt(fieldsRubrik);
    root().adopt(fieldGrid);
    root().adopt(rangeRubrik);
    root().adopt(fromLbl);
    root().adopt(fromDrop);
    root().adopt(toLbl);
    root().adopt(toDrop);
    root().adopt(allBtn);
    root().adopt(countLbl);
    root().adopt(previewRubrik);
    root().adopt(previewGrid);
}
