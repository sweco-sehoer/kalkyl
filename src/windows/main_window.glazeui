    byggPmGrid.x = 16;
    byggPmGrid.anchorTop = {"byggPmRubrik", 8};
    byggPmGrid.right = 16;
    byggPmGrid.bottom = 8;
    byggPmGrid.setColumns({{.text = "Uppgift", .width = 300, .sizing = glaze::ColumnSizing::Autosize}, {.text = "Värde", .width = 312}, {.text = "Referens", .width = 168}});

    stolpRubrik.name = "stolpRubrik";
