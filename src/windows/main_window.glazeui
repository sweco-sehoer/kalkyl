    lcPanel.name = "lcPanel";
    lcPanel.dock = glaze::Dock::Fill;

    byggPmRubrik.name = "byggPmRubrik";
    byggPmRubrik.setText("Enligt ByggPM");
    byggPmRubrik.setRole(glaze::Label::Role::Heading);
    byggPmRubrik.x = 16;
    byggPmRubrik.y = 12;

    byggPmBla.name = "byggPmBla";
    byggPmBla.setText("■");
    byggPmBla.setColor(gfx::Color{60, 130, 210, 255});
    byggPmBla.setToolTip("Linor och konfiguration");
    byggPmBla.anchorLeft = {"byggPmRubrik", 12};
    byggPmBla.y = 18;

    byggPmGron.name = "byggPmGron";
    byggPmGron.setText("■");
    byggPmGron.setColor(gfx::Color{70, 170, 90, 255});
    byggPmGron.setToolTip("Uppspänning och normalspann");
    byggPmGron.anchorLeft = {"byggPmBla", 6};
    byggPmGron.y = 18;

    byggPmGul.name = "byggPmGul";
