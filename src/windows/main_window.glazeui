    byggPmGrid.name = "byggPmGrid";
    byggPmGrid.anchors = {true, true, true, true};
    byggPmGrid.x = 16;
    byggPmGrid.anchorTop = {"byggPmRubrik", 8};
    byggPmGrid.right = 16;
    byggPmGrid.bottom = 8;
    byggPmGrid.setColumns({{.text = "Uppgift", .width = 300, .sizing = glaze::ColumnSizing::Autosize}, {.text = "Värde", .width = 312}, {.text = "Referens", .width = 168}});

    stolpRubrik.name = "stolpRubrik";
    stolpRubrik.setText("Data enligt dokumentation");
    stolpRubrik.setRole(glaze::Label::Role::Heading);
    stolpRubrik.x = 16;
    stolpRubrik.y = 8;

    stolpInfo.name = "stolpInfo";
    stolpInfo.setText("Klistra in från Excel med Ctrl+V i den cell där inklistringen ska börja: en cell, rader, kolumner eller ett block. Komma och punkt fungerar båda som decimaltecken, och talen visas med så många decimaler som du skriver. Skriv i den tomma raden sist för att lägga till en stolpe, och ta bort en rad med papperskorgen längst till höger.");
    stolpInfo.setRole(glaze::Label::Role::Dim);
    stolpInfo.setWrap(true);
    stolpInfo.anchors = {true, true, true, false};
    stolpInfo.x = 16;
    stolpInfo.anchorTop = {"stolpRubrik", 4};
    stolpInfo.right = 16;

    stolpGrid.name = "stolpGrid";
    stolpGrid.anchors = {true, true, true, true};
    stolpGrid.x = 16;
    stolpGrid.anchorTop = {"stolpInfo", 8};
    stolpGrid.right = 16;
    stolpGrid.bottom = 16;
    stolpGrid.setSortable(false);
    stolpGrid.setEditOnClick(false);
    stolpGrid.setHeaderLines(2);
    stolpGrid.setColumns({{.text = "Stolpplats", .width = 120, .sizing = glaze::ColumnSizing::Autosize}, {.text = "Av", .width = 70, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Vertikal linlängd (m) som belastar stolpen. Komma eller punkt som decimaltecken, och decimalerna visas som du skriver dem."}, {.text = "Ah", .width = 70, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Horisontell linlängd (m), för vindberäkningar. Komma eller punkt som decimaltecken, och decimalerna visas som du skriver dem."}, {.text = "Spannlängd\nföreg.", .width = 90, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Spannlängden (m) till föregående stolpe. Komma eller punkt som decimaltecken, och decimalerna visas som du skriver dem."}, {.text = "Koordinat\nN", .width = 120, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Koordinat N (m). Komma eller punkt som decimaltecken, och decimalerna visas som du skriver dem."}, {.text = "Koordinat\nE", .width = 110, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Koordinat E (m). Komma eller punkt som decimaltecken, och decimalerna visas som du skriver dem."}, {.text = "Koordinat\nH", .width = 80, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Koordinat H (m). Komma eller punkt som decimaltecken, och decimalerna visas som du skriver dem."}, {.text = "LKL", .width = 80, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Längdklass: fackverkstolpens längd i decimeter, till exempel 262 = 26,2 m."}, {.text = "", .width = 36, .align = glaze::Align::Center, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Radera raden"}});
    stolpGrid.setColumnEditor(1, {glaze::DataGrid::Editor::Text});
    stolpGrid.setColumnEditor(2, {glaze::DataGrid::Editor::Text});
    stolpGrid.setColumnEditor(3, {glaze::DataGrid::Editor::Text});
