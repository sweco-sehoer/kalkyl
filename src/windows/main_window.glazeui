    stolpGrid.x = 16;
    stolpGrid.anchorTop = {"stolpRubrik", 8};
    stolpGrid.right = 16;
    stolpGrid.bottom = 16;
    stolpGrid.setHeaderLines(2);
    stolpGrid.setColumns({{.text = "Stolpplats", .width = 120, .sizing = glaze::ColumnSizing::Autosize}, {.text = "Av", .width = 70, .align = glaze::Align::Right}, {.text = "Ah", .width = 70, .align = glaze::Align::Right}, {.text = "Spannlängd\nföreg.", .width = 90, .align = glaze::Align::Right}, {.text = "Koordinat\nN", .width = 120, .align = glaze::Align::Right}, {.text = "Koordinat\nE", .width = 110, .align = glaze::Align::Right}, {.text = "Koordinat\nH", .width = 80, .align = glaze::Align::Right}, {.text = "LKL", .width = 80}});
    stolpGrid.setColumnEditor(1, {glaze::DataGrid::Editor::Number});
    stolpGrid.setColumnEditor(2, {glaze::DataGrid::Editor::Number});
    stolpGrid.setColumnEditor(3, {glaze::DataGrid::Editor::Number});
    stolpGrid.setColumnEditor(4, {.editor = glaze::DataGrid::Editor::Number, .decimals = 2});
    stolpGrid.setColumnEditor(5, {.editor = glaze::DataGrid::Editor::Number, .decimals = 2});
    stolpGrid.setColumnEditor(6, {.editor = glaze::DataGrid::Editor::Number, .decimals = 2});
    stolpGrid.addRow({"ST0378", "363", "362", "348", "6512240.85", "412181.98", "44.19", "255/262"});
    stolpGrid.addRow({"ST0379", "267", "320", "375", "6511904.92", "412013.87", "28.05", ""});
    stolpGrid.addRow({"ST0380", "344", "345", "264", "6511653.69", "411933.25", "22.27", "262/262"});
    stolpGrid.addRow({"ST0381", "344", "374", "427", "6511247.08", "411804.35", "30.01", "262/262"});
    stolpGrid.addRow({"ST0382", "378", "305", "322", "6510940.33", "411706.06", "48.54", ""});
    stolpGrid.addRow({"ST0383", "181", "300", "287", "6510691.90", "411562.70", "42.00", "241/241"});

