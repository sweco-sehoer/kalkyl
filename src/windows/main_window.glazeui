#include "main_window.h"

MainWindow::MainWindow() { initializeComponent(); }

void MainWindow::initializeComponent()
{
    setTitle("Kalkyl");
    setContentSize(1280, 800);
    setMinimumSize(640, 400);
    setStartPosition(glaze::StartPosition::CenterScreen);

    appIcon.setIcon(glaze::img("app", "kalkyl"));
    appIcon.setSmallIcon(glaze::img("app32", "kalkyl"));
    appIcon.setLarge(true);

    menuBar.setInTitleBar(true);
    menuBar.show();
    menuBar.addMenu("Arkiv");
    menuBar.addItem("Arkiv", "Spara", "Ctrl+S");
    menuBar.addSeparator("Arkiv");
    menuBar.addItem("Arkiv", "Stäng projekt", "Ctrl+W");
    menuBar.addSeparator("Arkiv");
    menuBar.addItem("Arkiv", "Avsluta", "Alt+F4");
    menuBar.addMenu("Inställningar");
    menuBar.addItem("Inställningar", "Lindata…");
    menuBar.addSeparator("Inställningar");
    menuBar.addSubmenu("Inställningar", "Automatisk sparning");
    menuBar.addRadio({"Inställningar", "Automatisk sparning"}, "Av");
    menuBar.addRadio({"Inställningar", "Automatisk sparning"}, "1 minut");
    menuBar.addRadio({"Inställningar", "Automatisk sparning"}, "5 minuter", true);
    menuBar.addRadio({"Inställningar", "Automatisk sparning"}, "10 minuter");
    menuBar.addRadio({"Inställningar", "Automatisk sparning"}, "15 minuter");
    menuBar.addRadio({"Inställningar", "Automatisk sparning"}, "30 minuter");
    menuBar.addMenu("Hjälp");
    menuBar.addItem("Hjälp", "Om Kalkyl");

    statusBar.show();
    statusBar.addPanel("Redo", 0, true);

    autosaveTimer.name = "autosaveTimer";
    autosaveTimer.setInterval(300000);

    themeBtn.name = "themeBtn";
    themeBtn.setGlyphOnly(true);
    themeBtn.setImg(glaze::stockIcon(glaze::StockIcon::ThemeSystem));
    themeBtn.setToolTip("Utseende: System");
    themeBtn.dock = glaze::Dock::Right;

    flikar.name = "flikar";
    flikar.dock = glaze::Dock::Fill;

    byggPmSida.name = "byggPmSida";
    byggPmSida.setText("Dokumentation");

    stolpSida.name = "stolpSida";
    stolpSida.setText("Stolptabell före");

    nsSida.name = "nsSida";
    nsSida.setText("Normalspann");

    lcSida.name = "lcSida";
    lcSida.setText("Linberäkning");

    byggPmPanel.name = "byggPmPanel";
    byggPmPanel.dock = glaze::Dock::Fill;

    stolpPanel.name = "stolpPanel";
    stolpPanel.dock = glaze::Dock::Fill;

    nsPanel.name = "nsPanel";
