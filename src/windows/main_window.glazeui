    stolpInfo.name = "stolpInfo";
    stolpInfo.setText("Klistra in från Excel med Ctrl+V i den cell där inklistringen ska börja: en cell, rader, kolumner eller ett block. Importera stolptabell… hämtar i stället stolparna ur en stolptabell från Banken. Komma och punkt fungerar båda som decimaltecken, och talen visas med så många decimaler som du skriver. Skriv i den tomma raden sist för att lägga till en stolpe, och ta bort en rad med papperskorgen längst till höger. Med automatiskt läge räknas normalspann och linberäkning för faslinan och topplinorna ur stolparna mellan start och slut, och resultaten visas i Dokumentation.");
    stolpInfo.setRole(glaze::Label::Role::Dim);
