    efterGrid.setColumns({{.text = "Stolpnr", .width = 120, .sizing = glaze::ColumnSizing::Autosize}, {.text = "Koordinat\nN", .width = 120, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Koordinat N (m). Komma eller punkt som decimaltecken, och decimalerna visas som du skriver dem."}, {.text = "Koordinat\nE", .width = 110, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Koordinat E (m). Komma eller punkt som decimaltecken, och decimalerna visas som du skriver dem."}, {.text = "Koordinat\nH", .width = 80, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Koordinat H (m). Komma eller punkt som decimaltecken, och decimalerna visas som du skriver dem."}, {.text = "Avstånd\nföregående", .width = 90, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Spannlängden (m) till föregående stolpe. Lämnas den tom räknas den ur koordinaterna N och E (Σ). Komma eller punkt som decimaltecken, och decimalerna visas som du skriver dem."}, {.text = "Ah", .width = 70, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Horisontell linlängd (m), för vindberäkningar. Komma eller punkt som decimaltecken, och decimalerna visas som du skriver dem."}, {.text = "Av", .width = 70, .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Vertikal linlängd (m) som belastar stolpen. Komma eller punkt som decimaltecken, och decimalerna visas som du skriver dem."}, {.text = "LKL", .width = 80, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Längdklass: fackverkstolpens längd i decimeter, till exempel 262 = 26,2 m. Två klasser skrivs 227/262, också när de klistras in på två rader."},{.text = "", .width = 36, .align = glaze::Align::Center, .sizing = glaze::ColumnSizing::AutoMin, .toolTip = "Radera raden"}});
