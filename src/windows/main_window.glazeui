    byggPmGrid.onCommit = [this](glaze::Widget* s, glaze::CellChangeArgs& e) { byggPmGridCommitted(s, e); };
    glaze::AppWindow::onLoad = [this](glaze::Widget* s, glaze::EventArgs& e) { onLoad(s, e); };

    topBar.adopt(themeBtn);
    root().adopt(flikar);
    flikar.adopt(byggPmSida);
    flikar.adopt(stolpSida);
    byggPmSida.adopt(byggPmPanel);
    stolpSida.adopt(stolpPanel);
    byggPmPanel.adopt(byggPmRubrik);
    byggPmPanel.adopt(byggPmBla);
    byggPmPanel.adopt(byggPmGron);
    byggPmPanel.adopt(byggPmGul);
    byggPmPanel.adopt(byggPmFore);
    byggPmPanel.adopt(byggPmLila);
    byggPmPanel.adopt(byggPmEfter);
    byggPmPanel.adopt(byggPmRosa);
    byggPmPanel.adopt(byggPmGrid);
    stolpPanel.adopt(stolpRubrik);
