    docLbl.right = 16;

    infoLbl.name = "infoLbl";
    infoLbl.setText("Klistra in Stpnr, spannlängd och H från Excel med Ctrl+V i den cell där inklistringen ska börja. Spannlängd är det horisontella spannet före stolpen. Spannet före första stolpen ingår inte i summorna. H är plushöjd för mark eller infästning och är valfri.");
    infoLbl.setRole(glaze::Label::Role::Dim);
    infoLbl.setWrap(true);
    infoLbl.x = 16;
    infoLbl.anchorTop = {"docLbl", 4};
