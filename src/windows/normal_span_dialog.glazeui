#include "normal_span_dialog.h"

NormalSpanDialog::NormalSpanDialog() { initializeComponent(); }

void NormalSpanDialog::initializeComponent()
{
    setTitle("Normalspannsberäkning");
    setContentSize(1200, 720);
    setMinimumContentSize(920, 520);
    setStartPosition(glaze::StartPosition::CenterOwner);
    setModal(true);
    setAcceptButton(okBtn);
    setCancelButton(cancelBtn);

    statusBar.show();
    statusBar.addPanel("", 0, true);

    noteLbl.name = "noteLbl";
    noteLbl.setText("Anteckning");
    noteLbl.x = 16;
