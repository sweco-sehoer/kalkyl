    lim4Lbl.setText("4  aₙ,10 får inte understiga, × aₙ");
    lim4Lbl.setToolTip("Effekt av punkt 4, en sträcka av korta spann: det lokala normalspannet kan ge större nedhäng, vilket ska beaktas vid kontroll av fri höjd mot mark och korsande objekt.");
