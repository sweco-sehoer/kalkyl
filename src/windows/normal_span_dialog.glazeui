    methodLbl.name = "methodLbl";
    methodLbl.setText("Punkt 3 markerar raden och raden före. Punkt 4 och 5 kontrolleras från det elfte spannet: värdet är normalspannet för de 10 föregående spannen, aₙ,10, och kvoten mot aₙ. Normalspannsmetoden bygger på fri rörlighet av infästningspunkterna mellan avspänningsstolparna. Vid för stora avvikelser kan nedhänget anta en annan linbåge än normalspannets.");
    methodLbl.setRole(glaze::Label::Role::Dim);
