    poleGrid.setColumns({{.text = "Stpnr", .width = 110, .sizing = glaze::ColumnSizing::Autosize}, {.text = "Spannlängd\nm", .width = 100, .align = glaze::Align::Right}, {.text = "H\nm", .width = 80, .align = glaze::Align::Right}, {.text = "1\na/aₙ", .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin}, {.text = "2\na/aₙ", .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin}, {.text = "3\ngrannspann", .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin}, {.text = "4\naₙ,10 / kvot", .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin}, {.text = "5\naₙ,10 / kvot", .align = glaze::Align::Right, .sizing = glaze::ColumnSizing::AutoMin}});
    poleGrid.setColumnEditor(0, {glaze::DataGrid::Editor::Text});
    poleGrid.setColumnEditor(1, {.editor = glaze::DataGrid::Editor::Number, .allowEmpty = true});
    poleGrid.setColumnEditor(2, {.editor = glaze::DataGrid::Editor::Number, .allowEmpty = true});
    poleGrid.setColumnEditor(3, {glaze::DataGrid::Editor::None});
    poleGrid.setColumnEditor(4, {glaze::DataGrid::Editor::None});
    poleGrid.setColumnEditor(5, {glaze::DataGrid::Editor::None});
    poleGrid.setColumnEditor(6, {glaze::DataGrid::Editor::None});
    poleGrid.setColumnEditor(7, {glaze::DataGrid::Editor::None});
    poleGrid.setColumnToolTip(1, "Horisontellt spann före stolpen. Spannet före första stolpen ingår inte i summorna.");
    poleGrid.setColumnToolTip(2, "Plushöjd för mark eller infästning (valfri)");
    poleGrid.setColumnToolTip(3, "Kontroll 1: spannlängden delad med aₙ. Röd när den överstiger den längsta tillåtna.");
    poleGrid.setColumnToolTip(4, "Kontroll 2: spannlängden delad med aₙ. Röd när den understiger den kortaste tillåtna.");
    poleGrid.setColumnToolTip(5, "Kontroll 3: större delat med mindre av två intilliggande spann. Röd på raden och raden före när förhållandet överstiger gränsen.");
    poleGrid.setColumnToolTip(6, "Kontroll 4: normalspannet för de 10 föregående spannen och kvoten mot aₙ. Röd när kvoten understiger gränsen.");
    poleGrid.setColumnToolTip(7, "Kontroll 5: normalspannet för de 10 föregående spannen och kvoten mot aₙ. Röd när kvoten överstiger gränsen.");

